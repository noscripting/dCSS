{
  "name": "dcss",
  "version": "1.0.0",
  "description": "Pages that compute with no script: a list's statistics, ticks and nice ranges, scales, number and date formats, UTC dates, and a formula of your own solved, evaluated, sampled or set in motion, each as d3 works it out, in CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noscripting/dcss.git"
  },
  "keywords": [
    "css",
    "d3",
    "d3-array",
    "data",
    "statistics",
    "scale",
    "format",
    "no-javascript",
    "css-grid"
  ],
  "main": "dcss.css",
  "style": "dcss.css",
  "exports": {
    ".": "./dcss.css",
    "./*.css": "./*.css",
    "./families/*.css": "./families/*.css",
    "./parts/*.css": "./parts/*.css",
    "./families.json": "./families.json",
    "./package.json": "./package.json",
    "./steps.mjs": "./steps.mjs"
  },
  "files": [
    "dcss.css",
    "dcss-all.css",
    "dcss-extras.css",
    "families/",
    "parts/",
    "families.json",
    "steps.mjs",
    "dcss-preload.html",
    "README.md",
    "TUTORIAL.md",
    "SPEC.md",
    "QUIRKS.md",
    "CHANGELOG.md",
    "LICENSE",
    "compat.json"
  ]
}
